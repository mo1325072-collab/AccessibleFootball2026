# =============================================================================
# AccessibleFootball2026 - Git Ignore Rules
# =============================================================================

# Build outputs
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
check_db.cs
test_run.log

# Standalone and compiled binaries (excluding essential NVDA interop clients)
*.exe
*.dll
!AccessibleFootball2026.App/nvdaControllerClient32.dll
!AccessibleFootball2026.App/nvdaControllerClient64.dll
!nvdaControllerClient64.dll
*.pdb
*.msi
*.zip

# Visual Studio / Visual Studio Code / Rider
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Antigravity agent scratch directories
.agents/
.gemini/
*.tmp

# User local settings
settings.json

# Large External Assets (Raw PES 2013 audio dumps, Chants, Commentary)
# Default synthetic earcons are automatically generated by SoundEffectsPlayer on first launch.
Assets/
