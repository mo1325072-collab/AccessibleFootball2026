<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AccessibleFootball2026.Core\AccessibleFootball2026.Core.csproj" />
    <ProjectReference Include="..\AccessibleFootball2026.Audio\AccessibleFootball2026.Audio.csproj" />
    <ProjectReference Include="..\AccessibleFootball2026.Input\AccessibleFootball2026.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ThirdParty\NVDA\**\*" Link="ThirdParty\NVDA\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="nvdaControllerClient64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- نسخة 32-بت اختيارية: اللعبة تستخدم نسخة 64-بت فقط، والشرط يمنع كسر البناء عند غيابها -->
    <None Include="nvdaControllerClient32.dll" Condition="Exists('nvdaControllerClient32.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>AccessibleFootball2026</AssemblyName>
    <Version>2026.11.14</Version>
    <AssemblyVersion>2026.11.14.0</AssemblyVersion>
    <FileVersion>2026.11.14.0</FileVersion>
  </PropertyGroup>

</Project>

